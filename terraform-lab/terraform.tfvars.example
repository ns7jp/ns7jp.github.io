# 実際の値は terraform.tfvars (gitignore 対象) にコピーして使う。
# このファイル自体はレビュー用に公開する。

project             = "infralab"
environment         = "dev"
location            = "japaneast"
vm_size             = "Standard_B1s"
admin_username      = "azureuser"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# 自宅やオフィスの固定 IP/32 を指定。可変 IP の場合は VPN/Bastion を別途検討する。
admin_source_cidr = "203.0.113.10/32"
