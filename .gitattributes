# Existing root HTML files intentionally use CRLF; keep their bytes stable and
# teach whitespace checks that CR is part of the line ending.
.gitattributes text eol=lf
*.html -text whitespace=cr-at-eol

*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
robots.txt text eol=lf

*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
