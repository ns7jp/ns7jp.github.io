{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "CPU 使用率",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "メモリ使用率",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "ディスク空き率 (/)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 25 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Load average (1/5/15)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "node_load1",  "legendFormat": "load1 {{host}}" },
        { "expr": "node_load5",  "legendFormat": "load5 {{host}}" },
        { "expr": "node_load15", "legendFormat": "load15 {{host}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "ネットワーク受信 (bytes/s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*\"}[5m])",
          "legendFormat": "{{device}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "type": "logs",
      "title": "Syslog / auth.log (Loki)",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{job=~\"syslog|auth\", host=\"lab-host-01\"} |~ \"(?i)(error|warn|fail|denied|critical)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 14 }
    },
    {
      "type": "alertlist",
      "title": "Alertmanager — 現在のアラート",
      "datasource": "Alertmanager",
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": ["alertname"],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 3,
        "stateFilter": {
          "active": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        },
        "viewMode": "list"
      },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "ログ流入量 / job 別 (Loki)",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "sum by (job) (rate({host=\"lab-host-01\"}[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/sec"
        }
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 24 }
    }
  ],
  "schemaVersion": 39,
  "tags": ["lab", "node", "logs", "alerts"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Node Overview (Lab)",
  "uid": "node-overview-lab",
  "version": 2
}
