# これは「暗号化前の例」 です。実ファイルは sops で暗号化された .enc.yaml になります。
# このサンプルでは `data` フィールドの値が ENC[AES256_GCM,...] のような暗号文に置き換わります。

apiVersion: v1
kind: Secret
metadata:
  name: web-credentials
  namespace: lab-prod
type: Opaque
stringData:
  db_password: REPLACE_WITH_REAL_PASSWORD
  api_token: REPLACE_WITH_REAL_TOKEN
